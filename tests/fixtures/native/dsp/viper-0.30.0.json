            "type": "number",
            "label": "座位",
            "defaultValue": 8,
            "range": {
              "min": 1,
              "max": 12,
              "step": 1
            },
            "ownership": "provider",
            "description": "歌剧院和体育场支持 1–12；酷狗现场支持 1–11。"
          }
        ]
      },
      {
        "id": "kugou-ancient-vocal",
