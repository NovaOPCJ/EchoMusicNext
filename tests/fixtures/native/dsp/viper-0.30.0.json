{
  "id": "echomusic-viper",
  "version": "0.30.0",
  "manifest": {
    "schemaVersion": 1,
    "displayName": "ViPER 音效引擎",
    "description": "提供黑胶唱片、黑钻蝰蛇等预设，支持预设参数调节、VPF 与脉冲响应处理",
    "vendor": "EchoMusicViper",
    "resources": [
      {
        "kind": "vpf",
        "extensions": [
          ".vpf"
        ]
      },
      {
        "kind": "impulse-response",
        "extensions": [
          ".wav",
          ".irs"
        ]
      }
    ],
    "presets": [
      {
        "id": "kugou-3d-liyin",
        "label": "3D丽音",
        "description": "拓宽声场与声音层次，建议使用耳机",
        "recommendedDevice": "headphone",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "q24-haas-surround",
          "q24-playback-gain",
          "q24-soft-limiter"
        ]
      },
      {
        "id": "kugou-super-bass",
        "label": "超重低音",
        "description": "增强低频量感与下潜表现",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "dynamic-bass-q24",
          "soft-limiter"
        ]
      },
      {
        "id": "kugou-hifi-live",
        "label": "HiFi现场",
        "description": "增强现场空间感与声音细节",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "macos-virtualizer-2x2-fir",
          "macos-viper-natural-sound",
          "q24-level-controller",
          "q24-lookahead-limiter",
          "macos-float-resampler"
        ]
      },
      {
        "id": "kugou-3d-surround",
        "label": "3D环绕",
        "description": "选择球形环绕或固定声场，建议使用耳机",
        "recommendedDevice": "headphone",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "macos-vcc-graph",
          "script-binaural-hrtf",
          "hall-zrev2",
          "simple-plate-reverb",
          "soft-limiter"
        ],
        "controls": [
          {
            "id": "mode",
            "type": "select",
            "label": "环绕模式",
            "defaultValue": 0,
            "ownership": "provider",
            "options": [
              {
                "value": 0,
                "label": "球形环绕"
              },
              {
                "value": 1,
                "label": "声场模式"
              }
            ]
          },
          {
            "id": "speed",
            "type": "select",
            "label": "环绕周期",
            "defaultValue": 2,
            "ownership": "provider",
            "visibleWhen": {
              "controlId": "mode",
              "value": 0
            },
            "options": [
              {
                "value": 0,
                "label": "15 秒"
              },
              {
                "value": 1,
                "label": "12 秒"
              },
              {
                "value": 2,
                "label": "10 秒"
              },
              {
                "value": 3,
                "label": "8 秒"
              },
              {
                "value": 4,
                "label": "5 秒"
              }
            ]
          },
          {
            "id": "level",
            "type": "select",
            "label": "声场大小",
            "defaultValue": 2,
            "ownership": "provider",
            "visibleWhen": {
              "controlId": "mode",
              "value": 1
            },
            "options": [
              {
                "value": 0,
                "label": "小"
              },
              {
                "value": 1,
                "label": "较小"
              },
              {
                "value": 2,
                "label": "中"
              },
              {
                "value": 3,
                "label": "较大"
              },
              {
                "value": 4,
                "label": "大"
              }
            ]
          }
        ]
      },
      {
        "id": "kugou-black-diamond",
        "label": "黑钻蝰蛇",
        "description": "增强声音厚度、空间感与动态表现",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "macos-vinyl-nonlinear-core",
          "v4a-rate-wrapper",
          "raw-device-irs",
          "q25-soft-limiter",
          "q24-wrapper-dynamics"
        ]
      },
      {
        "id": "kugou-spatial",
        "label": "空间音效",
        "description": "手动调整声场方向，建议使用耳机",
        "recommendedDevice": "headphone",
        "supportedSampleRates": [
          44100,
          48000,
          96000
        ],
        "modules": [
          "viperar-angle-kernel",
          "viperar-startup-crossfade",
          "viperar-live-crossfade",
          "viperar-q25-master-limiter"
        ],
        "controls": [
          {
            "id": "mode",
            "type": "boolean",
            "label": "控制方式",
            "defaultValue": true,
            "ownership": "provider",
            "description": "自动模式暂不可用，请使用手动模式。",
            "options": [
              {
                "value": false,
                "label": "自动",
                "disabled": true
              },
              {
                "value": true,
                "label": "手动"
              }
            ]
          },
          {
            "id": "angle",
            "type": "number",
            "label": "声场方向",
            "defaultValue": 0,
            "unit": "°",
            "range": {
              "min": 0,
              "max": 359,
              "step": 1,
              "minLabel": "0°",
              "maxLabel": "359°"
            },
            "ownership": "provider",
            "visibleWhen": {
              "controlId": "mode",
              "value": true
            },
            "description": "手动选择声场方向。"
          }
        ]
      },
      {
