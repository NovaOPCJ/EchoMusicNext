        "controls": [
          {
            "id": "balance",
            "type": "number",
            "label": "人声 / 乐器平衡",
            "defaultValue": 25,
            "unit": "%",
            "range": {
              "min": 0,
              "max": 100,
              "step": 1
            },
            "ownership": "provider",
            "description": "向左突出人声，向右突出乐器；默认 25%。"
          }
        ]
      },
      {
        "id": "kugou-clear-vocal",
