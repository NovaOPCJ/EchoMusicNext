BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterControlStatement: Never
AccessModifierOffset: -4
PointerAlignment: Right
SortIncludes: Never
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
  - Q_OBJECT
  - Q_GADGET
  - Q_PROPERTY
  - Q_ENUM
  - Q_DECLARE_METATYPE
  - QML_ELEMENT
  - QML_FOREIGN
  - QML_NAMED_ELEMENT
  - QML_SINGLETON
  - QML_UNCREATABLE
